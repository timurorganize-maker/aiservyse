# --- обязательно ---
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=

# --- доступ ---
# Telegram ID админов/владельцев через запятую (узнать: @userinfobot).
# Админы управляют премиум-эмодзи и видят /status.
ADMIN_IDS=
# Кому разрешено писать боту (через запятую). Пусто = всем. Админы разрешены всегда.
ALLOWED_USER_IDS=

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
TEMPERATURE=1.0
MAX_TOKENS=4096

# --- память диалога ---
HISTORY_LIMIT=24
DB_PATH=data/bot.db

# --- премиум-эмодзи: auto | on | off ---
# auto: включатся, когда админ с Telegram Premium напишет боту
PREMIUM_EMOJI=auto
