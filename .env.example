# --- обязательно ---
TELEGRAM_BOT_TOKEN=          # от @BotFather
DEEPSEEK_API_KEY=            # platform.deepseek.com
SUPABASE_URL=                # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=        # Project Settings -> API -> service_role (секретный!)
WEBHOOK_SECRET=              # любая длинная случайная строка (A-Z a-z 0-9 _ -)

# --- доступ ---
# Telegram ID через запятую (узнать: @userinfobot). Админы: премиум-эмодзи и /status.
ADMIN_IDS=
# Кому можно писать боту. Пусто = всем.
ALLOWED_USER_IDS=

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
TEMPERATURE=1.0
MAX_TOKENS=4096
HISTORY_LIMIT=24

# --- премиум-эмодзи: auto | on | off ---
PREMIUM_EMOJI=auto
